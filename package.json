{
  "name": "nebula-quanta",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CLI launcher for Nebula Quanta (Nebula-Hut N-body simulation engine).",
  "keywords": ["barnes-hut", "n-body", "simulation", "rust", "bun"],
  "bin": {
    "nq": "run.ts"
  },
  "scripts": {
    "nq": "bun run run.ts",
    "start": "bun run nq",
    "run": "bun run nq",
    "bench": "bash scripts/bench_sweep.sh",
    "bench:smoke": "bash scripts/smoke_bench_sweep.sh",
    "run:debug": "bun run run.ts --debug",
    "render": "bash scripts/render_video.sh",
    "render:preset": "bash scripts/render_presets.sh",
    "render:hd30": "bash scripts/render_presets.sh --preset hd30",
    "render:hd60": "bash scripts/render_presets.sh --preset hd60",
    "render:hq30": "bash scripts/render_presets.sh --preset hq30",
    "render:hq60": "bash scripts/render_presets.sh --preset hq60"
  }
}
